# Frontend env files — only .env.example may be committed
.env
.env.local
.env.*.local
.env.development.local
.env.production.local

# Cloud deploy secrets
cloud/.env

# Generic credential files
*.pem
*.key
*.pfx
secrets/
credentials.json

