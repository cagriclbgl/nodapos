# PizzaPos cloud — copy to .env and fill in real values.
# DO NOT commit .env to git.

# --- Domain & TLS -----------------------------------------------------------
DOMAIN=api.nodapos.com
ACME_EMAIL=admin@nodapos.com

# Comma-separated list of allowed origins for the admin panel (Vercel + local
# dev). Frontend on Vercel: https://nodapos.vercel.app or your custom domain.
CORS_ALLOWED_ORIGINS=https://nodapos.com,https://www.nodapos.com,http://localhost:3000

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=pizzapos
POSTGRES_USER=pizzapos
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Auth (JWT) -------------------------------------------------------------
# Must be >= 32 chars. Generate: openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# --- Sync (kasa ↔ cloud HMAC) -----------------------------------------------
# Same value goes into every kasa Electron's PIZZAPOS_HMAC_SECRET env var.
# Treat as carefully as a password — anyone with this can ingest fake events.
# Generate: openssl rand -hex 48
HMAC_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# --- Supervisor bootstrap (first-run only) ----------------------------------
# Used by Program.cs to seed a Supervisor row if no Supervisors exist yet.
# After first login, change the password from /supervisor and remove these
# values from .env (keeping them around lets a stale dump leak credentials).
SUPERVISOR_BOOTSTRAP_USERNAME=supervisor
SUPERVISOR_BOOTSTRAP_PASSWORD=CHANGE_ME_IMMEDIATELY
